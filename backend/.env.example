# Copie para backend/.env. Os dados do banco devem bater com o .env da raiz (docker-compose).
AMBIENTE=local
LOG_LEVEL=INFO
LOG_JSON=false

DATABASE_URL=postgresql+asyncpg://automacao:automacao@localhost:5433/automacao_industrial

# Embedding (Voyage voyage-context-4 → vector(1024)). Opcional até a ingestão.
# VOYAGE_API_KEY=
# VOYAGE_BASE_URL=https://api.voyageai.com/v1
# EMBEDDING_MODELO=voyage-context-4
# EMBEDDING_DIMENSAO=1024

# LLM (OpenAI GPT-5 mini). Opcional até o agente / descrição de figuras.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_MODELO=gpt-5-mini
