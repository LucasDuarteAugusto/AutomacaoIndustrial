# Copie para backend/.env:
#   Copy-Item .env.example .env
# Os dados do banco devem bater com o .env da raiz (docker-compose).
# Detalhes: docs/01-rodando-localmente.md e docs/10-armazenamento.md

# --- Aplicação (obrigatório para subir a API) ---
AMBIENTE=local
LOG_LEVEL=INFO
LOG_JSON=false
DATABASE_URL=postgresql+asyncpg://automacao:automacao@localhost:5433/automacao_industrial

# --- Armazenamento de PDFs (obrigatório no padrão local) ---
# local = pasta no disco | s3 = Cloudflare R2 ou AWS S3 (mesmo adaptador)
ARMAZENAMENTO_TIPO=local
ARMAZENAMENTO_CAMINHO=data/arquivos
# Limite do upload POST /v1/documentos/{id}/arquivo (50 MiB por padrão)
ARMAZENAMENTO_TAMANHO_MAX_BYTES=52428800
# Pipeline de ingestão (chunking → Voyage → TRECHOS)
INGESTAO_TAMANHO_TRECHO_CHARS=2500
INGESTAO_MAX_CHARS_LOTE_EMBEDDING=80000
# Busca híbrida (RRF vetorial + textual)
BUSCA_CANDIDATOS_POR_MODO=40
BUSCA_RRF_K=60

# --- Object storage S3-compatível (preencher só se ARMAZENAMENTO_TIPO=s3) ---
# Cloudflare R2 (recomendado depois do local):
#   S3_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
#   S3_REGION=auto
# AWS S3 (produção futura): omita S3_ENDPOINT_URL e use a região da conta
#   S3_REGION=us-east-1
S3_ENDPOINT_URL=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Embedding Voyage (preencher na ingestão / busca semântica) ---
# Modelo padrão: voyage-context-4 → vector(1024). Conta: https://www.voyageai.com/
VOYAGE_API_KEY=
VOYAGE_BASE_URL=https://api.voyageai.com/v1
EMBEDDING_MODELO=voyage-context-4
EMBEDDING_DIMENSAO=1024

# --- LLM OpenAI (preencher no agente / descrição de figuras) ---
# Modelo padrão: gpt-5-mini. Conta: https://platform.openai.com/
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODELO=gpt-5-mini

# --- Auth JWT + CORS (detalhes: docs/13-auth.md) ---
# Troque JWT_SECRET em qualquer ambiente compartilhado / produção
JWT_SECRET=altere-este-segredo-em-producao-32b
JWT_ALGORITHM=HS256
JWT_EXPIRACAO_MINUTOS=480
# Origens do frontend (vírgula). Vite costuma usar 5173.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Rate limit (docs/18-rate-limit.md) ---
RATE_LIMIT_HABILITADO=true
RATE_LIMIT_BACKEND=memoria
RATE_LIMIT_AUTH_POR_MINUTO=20
RATE_LIMIT_BUSCA_POR_MINUTO=60
RATE_LIMIT_AGENTE_POR_MINUTO=20
RATE_LIMIT_PADRAO_POR_MINUTO=120
# REDIS_URL=redis://redis:6379/0  # usado quando RATE_LIMIT_BACKEND=redis
