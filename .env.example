# Copie para .env (na raiz). Usado pelo docker-compose.yml (db + api).
POSTGRES_USER=automacao
POSTGRES_PASSWORD=automacao
POSTGRES_DB=automacao_industrial
POSTGRES_PORT=5433

# API (serviço `api` no compose)
API_PORT=8000
AMBIENTE=local
LOG_LEVEL=INFO
LOG_JSON=false
JWT_SECRET=altere-este-segredo-em-producao-32b
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Chaves opcionais (ingestão / agente). Vazias = recursos externos desligados.
VOYAGE_API_KEY=
OPENAI_API_KEY=
