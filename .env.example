# Copie para .env e ajuste. Valores abaixo servem para o docker-compose local.
AMBIENTE=local
LOG_LEVEL=INFO
LOG_JSON=false

POSTGRES_USER=automacao
POSTGRES_PASSWORD=automacao
POSTGRES_DB=automacao_industrial
POSTGRES_PORT=5433

DATABASE_URL=postgresql+asyncpg://automacao:automacao@localhost:5433/automacao_industrial
