# Copie para .env.production (NÃO versionar) e preencha valores fortes.
# Uso: docker compose -f docker-compose.yml -f docker-compose.prod.yml --env-file .env.production up -d

# --- Banco (obrigatório) ---
POSTGRES_USER=automacao
POSTGRES_PASSWORD=troque-esta-senha-forte
POSTGRES_DB=automacao_industrial

# --- API (obrigatório) ---
API_PORT=8000
JWT_SECRET=gere-um-segredo-aleatorio-com-pelo-menos-32-bytes
# Origens do frontend em produção (vírgula, sem espaços extras desnecessários)
CORS_ORIGINS=https://app.seudominio.com

# --- Imagem (opcional) ---
# Vazio / omitido: build local a partir de backend/Dockerfile
# API_IMAGE=ghcr.io/lucasduarteaugusto/automacao-industrial-api:development

# --- IA (opcional até usar ingestão/agente) ---
VOYAGE_API_KEY=
OPENAI_API_KEY=

# --- Object storage (opcional; padrão local no volume) ---
ARMAZENAMENTO_TIPO=local
# ARMAZENAMENTO_TIPO=s3
# S3_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
